<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest Version="11.0" ExtensionBundleId="com.web2ai.cep"
    ExtensionBundleVersion="1.0.0" ExtensionBundleName="web2ai"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.web2ai.cep.panel" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- ILST = Illustrator; 25.0 = CC 2021, open-ended upper bound -->
      <Host Name="ILST" Version="[25.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <!-- A minimum, not a target. CEP checks it before anything else. -->
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.web2ai.cep.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <!-- host.jsx is auto-loaded into the ExtendScript engine -->
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <!-- build --enable-node fills this in; see docs/ARCHITECTURE.md -->
          <CEFCommandLine/>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>web2ai</Menu>
          <Geometry>
            <Size>
              <Height>560</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>300</Width>
            </MinSize>
            <MaxSize>
              <Height>1400</Height>
              <Width>520</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
