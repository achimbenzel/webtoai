{
  "name": "web2ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reconstruct any website's UI as a structured, layered Adobe Illustrator document.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:install": "node scripts/dev-install.mjs",
    "dev:uninstall": "node scripts/dev-install.mjs --uninstall",
    "fixtures": "node scripts/capture-fixtures.mjs",
    "fixtures:check": "node scripts/capture-fixtures.mjs --check",
    "schema:emit": "node --experimental-strip-types packages/schema/src/emit-json-schema.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.3",
    "acorn": "^8.18.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
